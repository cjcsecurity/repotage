Set Shell "zsh"
Set FontFamily "JetBrains Mono"
Set FontSize 28
Set Width 1920
Set Height 1080
Set Padding 64
Set LineHeight 1.4
Set TypingSpeed 42ms
Set Framerate 30
Set Theme { "name": "forge", "black": "#1a1917", "red": "#f0686a", "green": "#5fc98f", "yellow": "#e3b341", "blue": "#8fb3e8", "magenta": "#d29be0", "cyan": "#7fd0c8", "white": "#f3efe6", "brightBlack": "#6f6a62", "brightRed": "#f0686a", "brightGreen": "#5fc98f", "brightYellow": "#ffb347", "brightBlue": "#8fb3e8", "brightMagenta": "#d29be0", "brightCyan": "#7fd0c8", "brightWhite": "#ffffff", "background": "#121110", "foreground": "#f3efe6", "selection": "#2d2a26", "cursor": "#ff6a1a" }
